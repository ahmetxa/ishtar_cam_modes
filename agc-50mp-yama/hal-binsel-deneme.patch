# ishtar Faz 4.6 -- binning selector [S+0x3d84] DENEY yamasi -- A15 / vauxite
#
# 39 SATIR. Bu tablo AYRI kalir; raw50 / pixelarray / activearray
# tablolariyla indeks PAYLASMAZ ve onlarin USTUNE uygulanir.
#
# Ne yapar: her
#     ldr wN, [xM, #0x3d84]      ->      mov wN, #0
#
# Neden: [S+0x3d84] BINNING SECICISIDIR. Model zaten projenin kendi
# hal-activearray-deneme.patch basliginda yazili:
#     f0000: varsayilan S+0x3c54 (binnenmemis); secici==1 ise
#            S+0x3d98 (binnenmis) UZERINE yazilir
#     f000a: varsayilan S+0x3c24 ; uzerine S+0x3d88
# Yani secici sifirlanirsa hicbir tuketici binnenmis dala girmez.
#
# SATICI DOGRULAMASI (IMPL-41): Module_Highres_13U_Switcher_A14 ayni
# mekanizmayi kullanir. O modulun iki ikilisi arasindaki 228 baytlik
# farkin buyuk bolumu tam olarak budur:
#     disable/camera.qcom.so : 53 adet  ldr wN,[xM,#0x3d84]
#     enable /camera.qcom.so :  5 adet  -> 48 tanesi mov wN,#0
# Yani bu, saticinin BU CIHAZ icin sevk ettigi calisan yuksek-cozunurluk
# anahtarinin ta kendisidir. Ofsetler TASINMAZ (farkli derleme);
# buradaki 39 site canli ikili uzerinde yeniden turetilmistir.
#
# KAPSAM: 0x007xxxxx: 2 site, 0x012xxxxx: 2 site, 0x016xxxxx: 35 site
# (bunlarin 24'u metadata yayin bolgesi 0x0166xxxx icinde). Site
# 0x01662298, projenin kendi activearray yazma yeri 0x016622ac'ye
# 20 bayt uzakliktadir -- ayni islev bolgesi.
#
# GERI ALMA: ayni tablonun stok sutunu geri yazilir (revertbinsel.sh).
#
# bicim: <4bayt-indeksi> <stok-escape> <yamali-escape>
#   indeks = bayt_ofseti / 4  (dd bs=4 seek=<indeks> icin hazir)
#   escape dizileri printf '%b' ile YAZILDIGI GIBI kullanilir.
